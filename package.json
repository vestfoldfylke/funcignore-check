{
  "name": "funcignore-check",
  "version": "1.0.0",
  "description": "Tries to mimick the .funcignore functionality in GitHub Action azure/functions-action by reading the .funcignore file and show the output in console and/or in folder",
  "main": "index.ts",
  "scripts": {
    "clean": "rm -f *_console_output.json && rm -f *_folder_output.txt && rm -rf funcignore-output-*",
    "test": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "start": "node --env-file=.env --import tsx ./index.ts"
  },
  "keywords": [],
  "author": {
    "name": "Rune Moskvil Lyngås",
    "email": "rune.moskvil.lyngas@vestfoldfylke.no",
    "url": "https://github.com/runely"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "ignore": "^7.0.14"
  }
}
